# --- Application Configuration ---
PROJECT_NAME=Access2Java
BASE_PACKAGE=com.generated.app
FRONTEND_URL=http://localhost:5173

# --- Security & Authentication ---
# Generate a secure secret key for production
SESSION_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# URL for the job management database (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./converter_jobs_v2.db

# MongoDB Database Configuration (Optional: Use MongoDB for entire application)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=access2java

# --- Google OAuth ---
# Obtain these from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- GitHub OAuth ---
# Obtain these from GitHub Settings (Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# --- Email (SMTP) ---
# Used for password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@access2java.com

# --- LLM Provider ---
# OLLAMA or OPENROUTER
LLM_PROVIDER=OLLAMA
LLM_MODEL=deepseek-r1:1.5b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=not-needed-for-ollama
